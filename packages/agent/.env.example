GROQ_API_KEY=
TAVILY_API_KEY=

// MODELS
MAIN_MODEL=openai/gpt-6.1-sol
JUDGE_MODEL=anthropic/claude-haiku-5-5

// MODES
// Model a session starts with when it enters a mode without a stored
// selection. Switching modes keeps the model the session already uses.
// MODE_BUILD_MODEL=openai/gpt-6.1-sol
// MODE_PLAN_MODEL=openai/gpt-6.1-sol
// MODE_EXPLORE_MODEL=openai/gpt-5.4-mini
// Where plans are written. Relative paths resolve from the project root.
// MASTRA_PLANS_DIR=.mastracode/plans

// RUNS CONFIG
MAX_RUNS=50
MAX_STEPS=100

// PRODUCTS
PRODUCT_NAME=Fortune Code
CO_AUTHOR_NAME=
CO_AUTHOR_EMAIL=

// OBSERVABILITY
// Optional token that enables the Mastra Platform observability exporter.
MASTRA_PLATFORM_ACCESS_TOKEN=

// MEMORY
// Recent messages kept in context for the current thread.
MEMORY_LAST_MESSAGES=20
// Thread title generator. Defaults to MAIN_MODEL when unset.
// TITLE_MODEL=openai/gpt-6.1-sol
// Where the working-memory block is stored: resource (survives across every
// thread of the resource id, which is the project path) or thread (one
// conversation only).
WORKING_MEMORY_SCOPE=resource

// OBSERVATIONAL MEMORY
// Observations are always thread-scoped: Mastra removed the resource scope.
OM_ENABLED=true
// Observer and reflector model. Defaults to MAIN_MODEL when unset.
// OBSERVATIONAL_MEMORY_MODEL=openai/gpt-6.1-sol
// What happens when an observation or reflection run fails: continue (skip
// the cycle) or abort.
OM_FAILURE_POLICY=continue
// Register the recall tool so the agent can reach raw messages behind an
// observation group.
OM_RETRIEVAL=true
// Where recall may look: thread (current conversation) or resource (browse
// other threads of the same resource).
OM_RETRIEVAL_SCOPE=thread
// Force buffered observations to activate after inactivity. auto follows the
// provider prompt-cache TTL, a number is milliseconds, a duration string
// passes through.
OM_ACTIVATE_AFTER_IDLE=auto
// Re-activate buffered observations when the actor model or provider changes.
OM_ACTIVATE_ON_PROVIDER_CHANGE=true
// Let messages and observations share one token budget.
OM_SHARE_TOKEN_BUDGET=false
// Insert temporal-gap markers after long inactivity.
OM_TEMPORAL_MARKERS=true
// Observation trigger: message tokens buffered before observing.
OM_MESSAGE_TOKENS=30000
// Fraction of the context budget used for the observation buffer.
OM_BUFFER_TOKENS=0.2
// Buffer fill ratio that forces an observation.
OM_BUFFER_ACTIVATION=0.8
// Buffer overage ratio that blocks new messages until observation lands.
OM_BLOCK_AFTER=1.2
// Observation tokens carried over into the next cycle.
OM_PREVIOUS_OBSERVER_TOKENS=10000
// Let observational memory rewrite thread titles on topic changes.
OM_THREAD_TITLE=false
// Let the observer keep the working-memory block up to date.
OM_MANAGE_WORKNING_MEMORY=true
// Retries per observation or reflection run.
OM_MAX_RETRIES=8
// Reflection trigger: observation tokens that force a compression pass.
OM_REFLECTION_TOKENS=40000
// Observation fill ratio that forces a reflection.
OM_REFLECTION_BUFFER_ACTIVATION=0.5
