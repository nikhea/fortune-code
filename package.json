{
  "name": "fortune-code",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:agent": "bun run --cwd packages/agent dev",
    "dev:tui": "bun run --cwd packages/tui dev",
    "build": "bun run --cwd packages/agent build",
    "start": "bun run --cwd packages/agent start",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "trustedDependencies": [
    "agent-browser",
    "edgedriver",
    "esbuild",
    "geckodriver"
  ]
}
